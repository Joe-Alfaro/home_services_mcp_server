{
  "name": "home-services-mcp-server",
  "version": "0.1.0",
  "description": "A data layer and read-only, privacy-aware MCP server for a home-services marketplace.",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "scrub": "tsx scripts/scrub-check.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run scrub",
    "db:up": "docker compose up -d --wait",
    "migrate": "tsx src/cli/migrate.ts",
    "ingest": "tsx src/cli/setup.ts",
    "setup": "npm run db:up && npm run ingest",
    "mcp": "tsx src/cli/mcp.ts",
    "prepare": "husky",
    "start": "tsx src/cli/mcp.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "csv-parse": "^7.0.3",
    "luxon": "^3.7.2",
    "node-ical": "^0.27.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
